#!/usr/bin/env bash
# Pre-commit checks. Installed via `npm install` (package.json "prepare").
#   1. Prettier              — format staged files, then re-stage them.
#   2. Resume                — rebuild assets/resume.pdf if its sources changed.
#   3. Jekyll + html-proofer — build the site and validate links / HTML.
# Bypass with: git commit --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# 1. Format only what is staged.
PATTERN='\.(md|markdown|html|liquid|scss|css|json|yml|yaml|js|ts)$'
STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -E "$PATTERN" || true)"

if [ -n "$STAGED" ]; then
  PRETTIER="node_modules/.bin/prettier"
  if [ ! -x "$PRETTIER" ]; then
    echo "pre-commit: Prettier is not installed. Run: npm install" >&2
    exit 1
  fi
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    [ -f "$file" ] || continue
    "$PRETTIER" --write --ignore-unknown -- "$file"
    git add -- "$file"
  done <<< "$STAGED"
fi

# 2. Rebuild the resume PDF when its source changes, so the committed PDF can't
#    drift from _data/resume.yml.
RESUME_SRC="$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(_data/resume\.yml|tools/resume/(resume\.typ|fonts/))' || true)"
if [ -n "$RESUME_SRC" ]; then
  if command -v typst >/dev/null 2>&1; then
    bash tools/resume/build.sh
    git add assets/resume.pdf
  else
    echo "pre-commit: resume sources changed but typst is not installed." >&2
    echo "             install it with: brew install typst" >&2
    exit 1
  fi
fi

# 3. Build and validate the generated HTML.
#    DEBUG is unset rather than blanked: html-proofer treats any value, including
#    an empty one, as "on" and then wants a debug gem that is not in the bundle.
bundle exec jekyll build --quiet
env -u DEBUG RUBYOPT=-EUTF-8 bundle exec htmlproofer _site --disable-external
